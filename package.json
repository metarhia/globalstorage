{
  "name": "globalstorage",
  "version": "1.0.0",
  "author": "Timur Shemsedinov <timur.shemsedinov@gmail.com>",
  "description": "Global Storage is a Global Distributed Data Warehouse",
  "license": "MIT",
  "keywords": [
    "database",
    "globalstorage",
    "localstorage",
    "crdt",
    "sync",
    "storage",
    "global",
    "warehouse",
    "metarhia",
    "impress",
    "distributed",
    "db",
    "dbms"
  ],
  "readmeFilename": "README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/metarhia/globalstorage"
  },
  "main": "globalstorage.js",
  "types": "globalstorage.d.ts",
  "browser": {
    "./globalstorage.js": "./globalstorage.mjs"
  },
  "files": [
    "lib/",
    "globalstorage.mjs"
  ],
  "scripts": {
    "build": "metarhia-build",
    "test": "npm run lint && npm run types && node --test",
    "types": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier -c \"**/*.js\" \"**/*.json\" \"**/*.md\" \"**/*.ts\"",
    "fix": "eslint . --fix && prettier --write \"**/*.js\" \"**/*.json\" \"**/*.md\" \"**/*.ts\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "metacom": "^3.2.6",
    "metaschema": "^2.2.2",
    "metautil": "^5.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-metarhia": "^10.0.1",
    "metarhia-build": "^0.0.3",
    "metaskills": "^1.0.4",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "xxii-schema": "^0.0.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
